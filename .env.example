# =============================================
# MouroSub - Plantilla de variables de entorno
# Copia este archivo como ".env" y rellena los valores
# =============================================

# Servidor
APP_PORT=8080

# Base de datos
DB_URL=jdbc:mariadb://HOST:3306/pruebas_mourosub
DB_USERNAME=root
DB_PASSWORD=

# JPA (update | validate | create | none)
JPA_DDL_AUTO=update

# Mostrar SQL en consola (true solo para debug)
SPRING_JPA_SHOW_SQL=false

# Thymeleaf (false en dev, true en producción)
THYMELEAF_CACHE=false

# Ruta de subida de archivos (local dev)
UPLOADS_PATH=/ruta/a/mourosub-uploads

# Seed de datos demo (true en dev, false en producción)
APP_SEED_ENABLED=false

# FTP (delfer/alpine-ftp-server)
# Formato USERS: "usuario|contraseña|/ruta|uid"
FTP_USER=mourosub
FTP_PASSWORD=contraseña_segura
FTP_ADDRESS=IP_DEL_SERVIDOR

# Nginx proxy
NGINX_SERVER_NAME=tudominio.com
