# =============================================
# MouroSub - Plantilla de variables de entorno
# Copia este archivo como ".env" y rellena los valores
# =============================================

# Servidor
APP_PORT=8080

# Base de datos
DB_URL=jdbc:mariadb://localhost:3306/pruebas_mourosub
DB_USERNAME=root
DB_PASSWORD=

# JPA (update | validate | create | none)
JPA_DDL_AUTO=update

# Thymeleaf (false en dev, true en producción)
THYMELEAF_CACHE=false

# Ruta de subida de archivos
UPLOADS_PATH=/ruta/a/mourosub-uploads
