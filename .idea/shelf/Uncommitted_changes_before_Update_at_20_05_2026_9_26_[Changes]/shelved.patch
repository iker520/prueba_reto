r\n  text-decoration: none;\r\n}\r\n.ms-forgot-link:hover {\r\n  text-decoration: underline;\r\n}\r\n.ms-check-label {\r\n  font-size: 0.875rem;\r\n  color: var(--ms-on-surface-var);\r\n}\r\n.ms-login-divider {\r\n  border-color: var(--ms-outline-variant);\r\n  margin: 1.5rem 0;\r\n}\r\n.ms-login-footer-text {\r\n  font-size: 0.875rem;\r\n  color: var(--ms-on-surface-var);\r\n}\r\n.ms-login-footer-link {\r\n  color: var(--ms-primary);\r\n  font-weight: 700;\r\n  text-decoration: none;\r\n}\r\n.ms-login-footer-link:hover {\r\n  text-decoration: underline;\r\n}\r\n.ms-back-link {\r\n  color: var(--ms-on-surface-var);\r\n  font-size: 0.875rem;\r\n  text-decoration: none;\r\n}\r\n.ms-back-link:hover {\r\n  color: var(--ms-primary);\r\n}\r\n\r\n/* --- Footer --- */\r\n.ms-footer-text {\r\n  font-size: 0.8rem;\r\n  color: var(--ms-on-surface-var);\r\n}\r\n\r\n/* --- Index: hero content max-width --- */\r\n.ms-hero-content-wrap {\r\n  max-width: 600px;\r\n}\r\n\r\n/* --- Index: sección de noticias --- */\r\n.ms-news-header-title {\r\n  font-size: 2rem;\r\n  font-weight: 700;\r\n  color: var(--ms-primary);\r\n  letter-spacing: -0.01em;\r\n}\r\n.ms-news-header-text {\r\n  color: var(--ms-on-surface-var);\r\n}\r\n.ms-news-all-link {\r\n  color: var(--ms-primary);\r\n  text-decoration: none;\r\n  font-size: 0.9rem;\r\n  font-weight: 600;\r\n}\r\n.ms-news-all-link:hover {\r\n  text-decoration: underline;\r\n}\r\n.ms-fallback-text {\r\n  color: var(--ms-on-surface-var);\r\n}\r\n\r\n/* --- Index: card actividad h3 y precio --- */\r\n.ms-act-title {\r\n  font-size: 1.3rem;\r\n  font-weight: 600;\r\n}\r\n.ms-act-price {\r\n  font-size: 1.3rem;\r\n  font-weight: 700;\r\n}\r\n\r\n/* --- Index: CTA final texto --- */\r\n.ms-cta-final-title {\r\n  font-size: 2rem;\r\n  font-weight: 700;\r\n  letter-spacing: -0.01em;\r\n}\r\n\r\n/* --- ms-page-subtitle variante con max-width 560px --- */\r\n.ms-page-subtitle-sm {\r\n  font-size: 1.125rem;\r\n  color: var(--ms-on-surface-var);\r\n  max-width: 560px;\r\n  line-height: 1.6;\r\n}\r\n\r\n/* --- Noticias: título pequeño en sub-grid --- */\r\n.ms-news-card-title {\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  color: var(--ms-on-surface);\r\n  transition: color 0.2s;\r\n}\r\n.ms-news-card:hover .ms-news-card-title { color: var(--ms-primary); }\r\n\r\n/* --- Admin sidebar: label de sección --- */\r\n.ms-admin-section-label {\r\n  font-size: 0.65rem;\r\n  font-weight: 700;\r\n  letter-spacing: 0.1em;\r\n  text-transform: uppercase;\r\n  color: rgba(255, 255, 255, 0.4);\r\n  padding: 0 0.75rem;\r\n  margin-bottom: 0.5rem;\r\n  display: block;\r\n}\r\n.ms-admin-section-label-mt {\r\n  margin-top: 1rem;\r\n}\r\n\r\n/* --- Admin sidebar: brand subtitle --- */\r\n.ms-admin-brand-sub {\r\n  font-weight: 400;\r\n  font-size: 0.9rem;\r\n}\r\n\r\n/* --- Admin sidebar: footer links --- */\r\n.ms-admin-sidebar-footer {\r\n  border-top: 1px solid rgba(255, 255, 255, 0.15);\r\n  padding: 1rem 1.25rem;\r\n}\r\n.ms-admin-sidebar-link {\r\n  font-size: 0.8rem;\r\n}\r\n\r\n/* --- Admin topbar: page title y user --- */\r\n.ms-topbar-title {\r\n  color: var(--ms-on-surface);\r\n}\r\n.ms-topbar-user {\r\n  font-size: 0.85rem;\r\n  color: var(--ms-on-surface-var);\r\n}\r\n\r\n/* --- Admin: body background --- */\r\n.ms-admin-body {\r\n  background: var(--ms-background);\r\n}\r\n\r\n/* --- Admin: form content wrapper --- */\r\n.ms-admin-form-wrapper {\r\n  max-width: 900px;\r\n}\r\n\r\n/* --- Admin: sección \"Acciones Rápidas\" label --- */\r\n.ms-admin-section-header {\r\n  color: var(--ms-on-surface-var);\r\n  font-size: 0.85rem;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n}\r\n\r\n/* --- Admin: tabla: celda ID (color primary) --- */\r\n.ms-table-id {\r\n  color: var(--ms-primary);\r\n}\r\n\r\n/* --- Admin: tabla: celda secundaria pequeña --- */\r\n.ms-table-cell-sm {\r\n  font-size: 0.875rem;\r\n}\r\n.ms-table-cell-xs {\r\n  font-size: 0.8rem;\r\n  color: var(--ms-on-surface-var);\r\n}\r\n\r\n/* --- Admin: tabla: fila vacía --- */\r\n.ms-table-empty {\r\n  color: var(--ms-on-surface-var);\r\n}\r\n\r\n/* --- Admin: enlace inline en tabla --- */\r\n.ms-table-link {\r\n  color: var(--ms-primary);\r\n  text-decoration: none;\r\n}\r\n.ms-table-link:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n/* --- Admin: KPI variante secondary --- */\r\n.ms-kpi-secondary-icon {\r\n  background: var(--ms-secondary-container);\r\n  color: var(--ms-secondary);\r\n}\r\n.ms-kpi-secondary-number {\r\n  color: var(--ms-secondary);\r\n}\r\n\r\n/* --- Admin: cabecera de card (dashboard última reservas) --- */\r\n.ms-admin-card-header {\r\n  border-color: var(--ms-outline-variant) !important;\r\n}\r\n.ms-admin-card-header-title {\r\n  font-size: 0.95rem;\r\n}\r\n.ms-admin-card-header-link {\r\n  color: var(--ms-primary);\r\n  font-size: 0.85rem;\r\n  text-decoration: none;\r\n}\r\n.ms-admin-card-header-link:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n/* --- Admin: badge TipTap --- */\r\n.ms-badge-tiptap {\r\n  font-size: 0.65rem;\r\n}\r\n\r\n/* --- Admin: hint de contraseña en form --- */\r\n.ms-form-hint {\r\n  font-weight: 400;\r\n  color: var(--ms-outline);\r\n}\r\n\r\n/* --- Admin: max-width contenedor formulario usuario --- */\r\n.ms-admin-user-wrapper {\r\n  max-width: 960px;\r\n}\r\n\r\n/* --- Admin: sección de formulario (título de grupo) --- */\r\n.ms-admin-form-section-title {\r\n  color: var(--ms-primary);\r\n  border-bottom: 1px solid var(--ms-outline-variant);\r\n  font-size: 0.8rem;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n}\r\n\r\n/* --- Admin: count de total en listing --- */\r\n.ms-admin-list-count {\r\n  color: var(--ms-on-surface-var);\r\n  font-size: 0.9rem;\r\n}\r\n\r\n/* --- Error pages: inline style remnants --- */\r\n.error-page-h1 {\r\n  font-size: 1.5rem;\r\n  font-weight: 700;\r\n  margin-top: 0.5rem;\r\n}\r\n.error-page-p {\r\n  color: var(--ms-on-surface-var, #414750);\r\n  line-height: 1.7;\r\n  margin-top: 0.75rem;\r\n}\r\n.error-page-footer {\r\n  font-size: 0.75rem;\r\n  color: rgba(255, 255, 255, 0.4);\r\n}\r\n.error-page-footer-light {\r\n  font-size: 0.75rem;\r\n  color: rgba(255, 255, 255, 0.3);\r\n}\r\n.error-btn-outline-glass {\r\n  background: transparent;\r\n  border: 1px solid rgba(255, 255, 255, 0.4);\r\n  color: white;\r\n  font-weight: 600;\r\n  padding: 0.75rem 2rem;\r\n  border-radius: 0.5rem;\r\n  text-decoration: none;\r\n  transition: all 0.2s;\r\n  display: inline-block;\r\n}\r\n.error-btn-outline-glass:hover {\r\n  background: rgba(255, 255, 255, 0.1);\r\n  color: white;\r\n}\r\n.error-debug-block {\r\n  background: rgba(0, 0, 0, 0.3);\r\n  border-radius: 0.5rem;\r\n  font-size: 0.75rem;\r\n  color: rgba(255, 100, 100, 0.8);\r\n  font-family: monospace;\r\n}\r\n\r\n/* --- Footer: botones de redes sociales --- */\r\n.ms-footer-social-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.4rem;\r\n  padding: 0.4rem 0.75rem;\r\n  border: 1px solid var(--ms-outline-variant);\r\n  border-radius: 0.25rem;\r\n  font-size: 0.8rem;\r\n  font-weight: 600;\r\n  color: var(--ms-on-surface-var);\r\n  text-decoration: none;\r\n  background: var(--ms-surface-white);\r\n  transition: all 0.2s ease;\r\n}\r\n.ms-footer-social-btn:hover {\r\n  border-color: var(--ms-primary);\r\n  color: var(--ms-primary);\r\n  background: var(--ms-primary-fixed);\r\n}\r\n.ms-footer-social-btn i {\r\n  font-size: 1rem;\r\n}\r\n\r\n/* --- Utilidades extra extraídas de atributos style --- */\r\n.ms-opacity-90 { opacity: 0.9; }\r\n.ms-opacity-80 { opacity: 0.8; }\r\n.ms-icon-box-md { width: 52px; height: 52px; background-color: var(--ms-primary-fixed); }\r\n.ms-icon-box-lg { width: 64px; height: 64px; background-color: var(--ms-primary-fixed); }\r\n.ms-max-w-560 { max-width: 560px; }\r\n.ms-max-w-620 { max-width: 620px; }\r\n.ms-font-size-sm { font-size: 0.85rem; }\r\n.ms-border-radius-12 { border-radius: 12px; }\r\n.ms-badge-glass {\r\n  border-color: rgba(255,255,255,0.5) !important;\r\n  color: rgba(255,255,255,0.85) !important;\r\n  background: transparent !important;\r\n}\r\n\r\n.ms-footer-bottom {\r\n  background-color: var(--ms-outline-variant);\r\n  padding: 0.85rem 0;\r\n}\r\n.ms-footer-bottom p,\r\n.ms-footer-bottom a {\r\n  font-size: 0.8rem;\r\n  color: var(--ms-on-surface);\r\n  text-decoration: none;\r\n  transition: color 0.2s;\r\n}\r\n.ms-footer-bottom a:hover { color: var(--ms-primary); }
