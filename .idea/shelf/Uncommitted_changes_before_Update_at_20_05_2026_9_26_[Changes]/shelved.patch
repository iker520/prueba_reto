<+>/* ================================================================\r\n   MOUROSUB — Hoja de Estilos Principal\r\n   Paleta: Blueprint de Stitch / MouroSub Design System\r\n   Framework: Bootstrap 5 + Custom Variables\r\n   ================================================================ */\r\n\r\n/* --- Variables CSS / Design Tokens --- */\r\n:root {\r\n  --ms-primary:            #004275;\r\n  --ms-primary-container:  #005A9C;\r\n  --ms-on-primary:         #ffffff;\r\n  --ms-on-primary-cont:    #afd1ff;\r\n  --ms-primary-fixed:      #d2e4ff;\r\n  --ms-primary-fixed-dim:  #a1c9ff;\r\n\r\n  --ms-secondary:          #505f76;\r\n  --ms-secondary-container:#d0e1fb;\r\n  --ms-on-secondary:       #ffffff;\r\n\r\n  --ms-background:         #f7f9fb;\r\n  --ms-surface:            #f7f9fb;\r\n  --ms-surface-low:        #f2f4f6;\r\n  --ms-surface-high:       #e6e8ea;\r\n  --ms-surface-highest:    #e0e3e5;\r\n  --ms-surface-white:      #ffffff;\r\n\r\n  --ms-on-surface:         #191c1e;\r\n  --ms-on-surface-var:     #414750;\r\n  --ms-outline:            #727781;\r\n  --ms-outline-variant:    #c1c7d2;\r\n\r\n  --ms-error:              #ba1a1a;\r\n\r\n  /* Override Bootstrap primary */\r\n  --bs-primary:            var(--ms-primary);\r\n  --bs-primary-rgb:        0, 66, 117;\r\n  --bs-body-bg:            var(--ms-background);\r\n  --bs-body-color:         var(--ms-on-surface);\r\n  --bs-border-color:       var(--ms-outline-variant);\r\n  --bs-border-radius:      0.25rem;\r\n  --bs-border-radius-lg:   0.5rem;\r\n  --bs-font-sans-serif:    'Inter', system-ui, -apple-system, sans-serif;\r\n}\r\n\r\n/* --- Reset y Base --- */\r\nbody {\r\n  font-family: 'Inter', system-ui, -apple-system, sans-serif;\r\n  background-color: var(--ms-background);\r\n  color: var(--ms-on-surface);\r\n  -webkit-font-smoothing: antialiased;\r\n}\r\n\r\n/* --- Navbar --- */\r\n.ms-navbar {\r\n  background-color: var(--ms-surface-white) !important;\r\n  border-bottom: 1px solid var(--ms-outline-variant);\r\n  min-height: 80px;\r\n  padding-top: 0;\r\n  padding-bottom: 0;\r\n}\r\n.ms-navbar .navbar-brand {\r\n  font-size: 1.5rem;\r\n  font-weight: 700;\r\n  color: var(--ms-primary) !important;\r\n  letter-spacing: -0.02em;\r\n}\r\n.ms-navbar .nav-link {\r\n  font-size: 1rem;\r\n  font-weight: 400;\r\n  color: var(--ms-secondary) !important;\r\n  transition: color 0.2s ease;\r\n  padding: 0.25rem 0;\r\n}\r\n.ms-navbar .nav-link:hover,\r\n.ms-navbar .nav-link.active {\r\n  color: var(--ms-primary) !important;\r\n}\r\n.ms-navbar .nav-link.active {\r\n  font-weight: 700;\r\n  border-bottom: 2px solid var(--ms-primary);\r\n}\r\n/* Menú desplegado en móvil: separador visual */\r\n@media (max-width: 991.98px) {\r\n  .ms-navbar .navbar-collapse {\r\n    border-top: 1px solid var(--ms-outline-variant);\r\n    padding-top: 0.5rem;\r\n    padding-bottom: 0.75rem;\r\n    background-color: var(--ms-surface-white);\r\n  }\r\n  .ms-navbar .nav-link {\r\n    padding: 0.5rem 0;\r\n  }\r\n}\r\n\r\n/* --- Botones --- */\r\n.btn-ms-primary {\r\n  background-color: var(--ms-primary);\r\n  color: var(--ms-on-primary);\r\n  border: none;\r\n  font-weight: 600;\r\n  font-size: 0.875rem;\r\n  letter-spacing: 0.01em;\r\n  transition: all 0.15s ease;\r\n}\r\n.btn-ms-primary:hover {\r\n  background-color: var(--ms-primary-container);\r\n  color: var(--ms-on-primary);\r\n  transform: translateY(-1px);\r\n  box-shadow: 0 4px 12px rgba(0, 66, 117, 0.25);\r\n}\r\n.btn-ms-primary:active { transform: scale(0.97); }\r\n\r\n.btn-ms-outline {\r\n  background-color: transparent;\r\n  color: var(--ms-primary);\r\n  border: 1px solid var(--ms-primary);\r\n  font-weight: 600;\r\n  font-size: 0.875rem;\r\n  transition: all 0.15s ease;\r\n}\r\n.btn-ms-outline:hover {\r\n  background-color: var(--ms-primary-fixed);\r\n  color: var(--ms-primary);\r\n}\r\n\r\n/* --- Hero Section --- */\r\n.ms-hero {\r\n  position: relative;\r\n  min-height: 520px;\r\n  background-color: var(--ms-primary-container);\r\n  overflow: hidden;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.ms-hero-img {\r\n  position: absolute;\r\n  inset: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  opacity: 0.35;\r\n}\r\n.ms-hero-content {\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n.ms-hero h1 {\r\n  font-size: clamp(2rem, 5vw, 2.8rem);\r\n  font-weight: 700;\r\n  letter-spacing: -0.02em;\r\n  line-height: 1.2;\r\n  color: var(--ms-on-primary);\r\n}\r\n.ms-hero p {\r\n  font-size: 1.125rem;\r\n  color: var(--ms-on-primary-cont);\r\n  line-height: 1.6;\r\n}\r\n\r\n/* --- Cards --- */\r\n.ms-card {\r\n  background-color: var(--ms-surface-white);\r\n  border: 1px solid var(--ms-outline-variant);\r\n  border-radius: 0.5rem;\r\n  transition: box-shadow 0.2s ease, transform 0.2s ease;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n.ms-card:hover {\r\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);\r\n  transform: translateY(-2px);\r\n}\r\n.ms-card-img {\r\n  width: 100%;\r\n  height: 200px;\r\n  object-fit: cover;\r\n  border-radius: 0.5rem 0.5rem 0 0;\r\n  background-color: var(--ms-surface-high);\r\n}\r\n.ms-card-img-tall { height: 260px; }\r\n.ms-card-body { padding: 1.5rem; }\r\n\r\n/* --- Sección con fondo alternativo --- */\r\n.ms-section-alt {\r\n  background-color: var(--ms-surface-low);\r\n}\r\n.ms-section-dark {\r\n  background-color: var(--ms-primary);\r\n  color: var(--ms-on-primary);\r\n}\r\n\r\n/* --- Badges de tipo/categoría --- */\r\n.ms-badge {\r\n  display: inline-block;\r\n  padding: 0.2rem 0.6rem;\r\n  font-size: 0.7rem;\r\n  font-weight: 700;\r\n  letter-spacing: 0.05em;\r\n  text-transform: uppercase;\r\n  border-radius: 0.25rem;\r\n  background-color: var(--ms-primary);\r\n  color: var(--ms-on-primary);\r\n}\r\n.ms-badge-outline {\r\n  background-color: transparent;\r\n  border: 1px solid var(--ms-primary);\r\n  color: var(--ms-primary);\r\n}\r\n\r\n/* --- Stats Grid --- */\r\n.ms-stat-box {\r\n  background-color: var(--ms-surface-highest);\r\n  border: 1px solid var(--ms-outline-variant);\r\n  border-radius: 0.25rem;\r\n  padding: 1.5rem;\r\n  text-align: center;\r\n}\r\n.ms-stat-box .stat-number {\r\n  font-size: 2rem;\r\n  font-weight: 700;\r\n  color: var(--ms-primary);\r\n}\r\n.ms-stat-box .stat-label {\r\n  font-size: 0.7rem;\r\n  font-weight: 600;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n  color: var(--ms-on-surface-var);\r\n}\r\n\r\n/* --- Noticias --- */\r\n.ms-news-card { overflow: hidden; }\r\n.ms-news-card .news-img-wrapper {\r\n  overflow: hidden;\r\n  border-radius: 0.5rem 0.5rem 0 0;\r\n  height: 200px;\r\n}\r\n.ms-news-card .news-img-wrapper img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  transition: transform 0.5s ease;\r\n}\r\n.ms-news-card:hover .news-img-wrapper img { transform: scale(1.05); }\r\n.ms-news-card .news-cat {\r\n  font-size: 0.7rem;\r\n  font-weight: 600;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n  color: var(--ms-secondary);\r\n}\r\n.ms-news-card .news-title {\r\n  font-size: 1.1rem;\r\n  font-weight: 600;\r\n  color: var(--ms-on-surface);\r\n  transition: color 0.2s;\r\n}\r\n.ms-news-card:hover .news-title { color: var(--ms-primary); }\r\n\r\n/* --- Footer --- */\r\n.ms-footer {\r\n  background-color: var(--ms-surface-highest);\r\n  border-top: 1px solid var(--ms-outline-variant);\r\n}\r\n.ms-footer .footer-brand {\r\n  font-size: 1.3rem;\r\n  font-weight: 700;\r\n  color: var(--ms-on-surface);\r\n}\r\n.ms-footer a {\r\n  color: var(--ms-on-surface-var);\r\n  text-decoration: none;\r\n  font-size: 0.9rem;\r\n  transition: color 0.2s;\r\n}\r\n.ms-footer a:hover { color: var(--ms-primary); }\r\n\r\n/* --- Formularios --- */\r\n.ms-form-control {\r\n  border: 1px solid var(--ms-outline-variant);\r\n  border-radius: 0.25rem;\r\n  background-color: var(--ms-surface-white);\r\n  color: var(--ms-on-surface);\r\n  transition: border-color 0.15s, box-shadow 0.15s;\r\n}\r\n.ms-form-control:focus {\r\n  border-color: var(--ms-primary);\r\n  box-shadow: 0 0 0 3px rgba(0, 66, 117, 0.12);\r\n  outline: none;\r\n}\r\n.ms-form-control::placeholder { color: var(--ms-outline); }\r\n\r\n/* --- Navbar main container --- */\r\n.container-ms { max-width: 1280px; width: 100%; margin: 0 auto; padding: 0 1.5rem; }\r\n@media (max-width: 768px) { .container-ms { padding: 0 1rem; } }\r\n\r\n/* --- Instructor cards hover effect (grayscale) --- */\r\n.ms-instructor-card .instructor-img {\r\n  width: 100%;\r\n  aspect-ratio: 3/4;\r\n  object-fit: cover;\r\n  filter: grayscale(1);\r\n  transition: filter 0.3s ease;\r\n}\r\n.ms-instructor-card:hover .instructor-img { filter: grayscale(0); }\r\n.ms-instructor-badge {\r\n  position: absolute;\r\n  top: 0.75rem;\r\n  right: 0.75rem;\r\n  font-size: 0.65rem;\r\n  font-weight: 700;\r\n}\r\n\r\n/* --- Admin Panel Sidebar --- */\r\n.ms-admin-sidebar {\r\n  min-height: 100vh;\r\n  width: 260px;\r\n  background-color: var(--ms-primary);\r\n  color: var(--ms-on-primary);\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  overflow-y: auto;\r\n  z-index: 100;\r\n}\r\n.ms-admin-sidebar .sidebar-brand {\r\n  font-size: 1.3rem;\r\n  font-weight: 700;\r\n  color: var(--ms-on-primary);\r\n  padding: 1.5rem 1.25rem;\r\n  border-bottom: 1px solid rgba(255,255,255,0.15);\r\n  display: block;\r\n  text-decoration: none;\r\n}\r\n.ms-admin-sidebar .nav-link {\r\n  color: rgba(255, 255, 255, 0.8) !important;\r\n  font-size: 0.9rem;\r\n  padding: 0.65rem 1.25rem;\r\n  border-radius: 0.25rem;\r\n  margin: 0.125rem 0.5rem;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  transition: all 0.15s;\r\n  text-decoration: none;\r\n}\r\n.ms-admin-sidebar .nav-link:hover,\r\n.ms-admin-sidebar .nav-link.active {\r\n  color: #ffffff !important;\r\n  background-color: rgba(255, 255, 255, 0.15);\r\n}\r\n.ms-admin-sidebar .nav-link i { width: 18px; }\r\n\r\n.ms-admin-content {\r\n  margin-left: 260px;\r\n  min-height: 100vh;\r\n  background-color: var(--ms-background);\r\n}\r\n.ms-admin-topbar {\r\n  background-color: var(--ms-surface-white);\r\n  border-bottom: 1px solid var(--ms-outline-variant);\r\n  padding: 1rem 1.5rem;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n\r\n/* --- Admin KPI Cards --- */\r\n.ms-kpi-card {\r\n  background: var(--ms-surface-white);\r\n  border: 1px solid var(--ms-outline-variant);\r\n  border-radius: 0.5rem;\r\n  padding: 1.5rem;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 1rem;\r\n}\r\n.ms-kpi-card .kpi-icon {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 0.5rem;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background-color: var(--ms-primary-fixed);\r\n  color: var(--ms-primary);\r\n  font-size: 1.5rem;\r\n}\r\n.ms-kpi-card .kpi-number { font-size: 1.75rem; font-weight: 700; color: var(--ms-primary); }\r\n.ms-kpi-card .kpi-label { font-size: 0.8rem; color: var(--ms-on-surface-var); }\r\n\r\n/* --- TipTap editor container --- */\r\n#tiptap-editor {\r\n  border: 1px solid var(--ms-outline-variant);\r\n  border-radius: 0.25rem;\r\n  min-height: 300px;\r\n  padding: 1rem;\r\n  background: var(--ms-surface-white);\r\n  cursor: text;\r\n}\r\n#tiptap-editor:focus-within {\r\n  border-color: var(--ms-primary);\r\n  box-shadow: 0 0 0 3px rgba(0, 66, 117, 0.12);\r\n}\r\n.tiptap-toolbar {\r\n  border: 1px solid var(--ms-outline-variant);\r\n  border-bottom: none;\r\n  border-radius: 0.25rem 0.25rem 0 0;\r\n  padding: 0.5rem;\r\n  background: var(--ms-surface-low);\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 0.25rem;\r\n}\r\n.tiptap-toolbar button {\r\n  padding: 0.25rem 0.5rem;\r\n  border: 1px solid var(--ms-outline-variant);\r\n  background: var(--ms-surface-white);\r\n  border-radius: 0.25rem;\r\n  font-size: 0.8rem;\r\n  cursor: pointer;\r\n  transition: all 0.15s;\r\n}\r\n.tiptap-toolbar button:hover,\r\n.tiptap-toolbar button.is-active {\r\n  background-color: var(--ms-primary);\r\n  color: white;\r\n  border-color: var(--ms-primary);\r\n}\r\n\r\n/* --- Contenido HTML renderizado (th:utext) --- */\r\n.ms-rich-content h1,\r\n.ms-rich-content h2,\r\n.ms-rich-content h3 { color: var(--ms-primary); margin-top: 1.5rem; }\r\n.ms-rich-content p { line-height: 1.7; color: var(--ms-on-surface); }\r\n.ms-rich-content a { color: var(--ms-primary); }\r\n.ms-rich-content ul, .ms-rich-content ol { padding-left: 1.5rem; }\r\n.ms-rich-content blockquote {\r\n  border-left: 3px solid var(--ms-primary-container);\r\n  padding-left: 1rem;\r\n  color: var(--ms-on-surface-var);\r\n  font-style: italic;\r\n}\r\n\r\n/* --- Animaciones suaves --- */\r\n@keyframes fadeInUp {\r\n  from { opacity: 0; transform: translateY(16px); }\r\n  to   { opacity: 1; transform: translateY(0); }\r\n}\r\n.ms-animate { animation: fadeInUp 0.5s ease both; }\r\n.ms-animate-delay-1 { animation-delay: 0.1s; }\r\n.ms-animate-delay-2 { animation-delay: 0.2s; }\r\n.ms-animate-delay-3 { animation-delay: 0.3s; }\r\n\r\n/* --- Responsive admin --- */\r\n@media (max-width: 992px) {\r\n  .ms-admin-sidebar { display: none; }\r\n  .ms-admin-content { margin-left: 0; }\r\n}\r\n\r\n/* --- Tabla admin --- */\r\n.ms-table {\r\n  border-collapse: collapse;\r\n  width: 100%;\r\n  font-size: 0.9rem;\r\n}\r\n.ms-table th {\r\n  background-color: var(--ms-surface-low);\r\n  color: var(--ms-on-surface-var);\r\n  font-weight: 600;\r\n  font-size: 0.75rem;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n  padding: 0.75rem 1rem;\r\n  border-bottom: 1px solid var(--ms-outline-variant);\r\n}\r\n.ms-table td {\r\n  padding: 0.875rem 1rem;\r\n  border-bottom: 1px solid var(--ms-surface-high);\r\n  vertical-align: middle;\r\n}\r\n.ms-table tr:hover td { background-color: var(--ms-surface-low); }\r\n\r\n/* --- Estado badges --- */\r\n.badge-pendiente  { background-color: #f59e0b; color: white; }\r\n.badge-confirmada { background-color: #22c55e; color: white; }\r\n.badge-cancelada  { background-color: var(--ms-error); color: white; }\r\n.badge-completada { background-color: var(--ms-primary); color: white; }\r\n\r\n/* ================================================================\r\n   CLASES UTILITARIAS — reemplazan estilos inline del HTML\r\n   ================================================================ */\r\n\r\n/* --- Fondo blanco de superficie --- */\r\n.ms-surface-white-bg {\r\n  background: var(--ms-surface-white);\r\n}\r\n\r\n/* --- Ícono mediano (fallback cards) --- */\r\n.ms-icon-lg {\r\n  font-size: 2rem;\r\n  color: var(--ms-primary);\r\n}\r\n\r\n/* --- Body con offset de navbar fija --- */\r\n.page-body {\r\n  padding-top: 80px;\r\n}\r\n.page-body-login {\r\n  background: var(--ms-background);\r\n  min-height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n/* --- Contenedor de ancho máximo centrado --- */\r\n.ms-content-wrapper {\r\n  max-width: 1280px;\r\n  margin: 0 auto;\r\n  padding: 0 1.5rem;\r\n}\r\n.ms-content-wrapper-sm {\r\n  max-width: 640px;\r\n  margin: 0 auto;\r\n  padding: 0 1.5rem;\r\n}\r\n.ms-content-wrapper-md {\r\n  max-width: 560px;\r\n  margin: 0 auto;\r\n  padding: 0 1.5rem;\r\n}\r\n\r\n/* --- Cabeceras de página (hero-lite) --- */\r\n.ms-page-title {\r\n  font-size: 2.5rem;\r\n  font-weight: 700;\r\n  color: var(--ms-primary);\r\n  letter-spacing: -0.02em;\r\n}\r\n.ms-page-subtitle {\r\n  font-size: 1.125rem;\r\n  color: var(--ms-on-surface-var);\r\n  max-width: 640px;\r\n  line-height: 1.6;\r\n}\r\n\r\n/* --- Barra de tabs sticky --- */\r\n.ms-sticky-tabs {\r\n  position: sticky;\r\n  top: 80px;\r\n  z-index: 40;\r\n  background: var(--ms-background);\r\n  padding: 1rem 0;\r\n}\r\n\r\n/* --- Sección con borde inferior de color outline --- */\r\n.ms-section-border-bottom {\r\n  border-bottom: 1px solid var(--ms-outline-variant) !important;\r\n}\r\n.ms-section-border-top {\r\n  border-top: 1px solid var(--ms-outline-variant) !important;\r\n}\r\n\r\n/* --- Grid de contenido principal con padding bottom --- */\r\n.ms-grid-section {\r\n  padding: 1rem 0 4rem;\r\n}\r\n\r\n/* --- Imagen de fondo en card (altura fija) --- */\r\n.ms-card-img-container {\r\n  height: 220px;\r\n  border-radius: 0.5rem 0.5rem 0 0;\r\n  background-size: cover;\r\n  background-position: center;\r\n  position: relative;\r\n}\r\n.ms-badge-floating {\r\n  position: absolute;\r\n  top: 0.75rem;\r\n  left: 0.75rem;\r\n}\r\n/* Tarjeta destacada (más grande en desktop) */\r\n@media (min-width: 768px) {\r\n  .featured-card .ms-card-img-container {\r\n    height: 320px;\r\n  }\r\n}\r\n\r\n/* --- Placeholder sin imagen en card --- */\r\n.ms-card-img-placeholder {\r\n  height: 120px;\r\n  background: var(--ms-surface-high);\r\n  border-radius: 0.5rem 0.5rem 0 0;\r\n}\r\n.ms-icon-placeholder {\r\n  font-size: 2.5rem;\r\n  color: var(--ms-primary);\r\n  opacity: 0.5;\r\n}\r\n\r\n/* --- Títulos y textos en tarjetas --- */\r\n.ms-card-title {\r\n  font-size: 1.2rem;\r\n  font-weight: 600;\r\n  color: var(--ms-primary);\r\n}\r\n.ms-card-desc {\r\n  color: var(--ms-on-surface-var);\r\n  font-size: 0.9rem;\r\n  line-height: 1.6;\r\n  flex-grow: 1;\r\n}\r\n.ms-card-footer-border {\r\n  border-top: 1px solid var(--ms-outline-variant);\r\n}\r\n\r\n/* --- Precios y duraciones --- */\r\n.ms-price {\r\n  font-size: 1.3rem;\r\n  font-weight: 700;\r\n}\r\n.ms-duration {\r\n  font-size: 0.75rem;\r\n}\r\n.ms-price-lg {\r\n  font-size: 1.5rem;\r\n  font-weight: 700;\r\n  color: var(--ms-primary);\r\n}\r\n\r\n/* --- Estado vacío --- */\r\n.ms-empty-icon {\r\n  font-size: 3rem;\r\n  color: var(--ms-outline);\r\n}\r\n.ms-empty-text {\r\n  color: var(--ms-on-surface-var);\r\n}\r\n\r\n/* --- CTA sections --- */\r\n.ms-cta-title {\r\n  font-weight: 700;\r\n  color: var(--ms-primary);\r\n}\r\n.ms-cta-text {\r\n  color: var(--ms-on-surface-var);\r\n}\r\n.ms-cta-dark-text {\r\n  color: var(--ms-on-primary-cont);\r\n  line-height: 1.7;\r\n}\r\n\r\n/* --- Botones especiales (fondo oscuro) --- */\r\n.ms-hero-btn-secondary {\r\n  background-