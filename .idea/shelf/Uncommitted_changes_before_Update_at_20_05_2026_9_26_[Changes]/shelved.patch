<+><!DOCTYPE html>\r\n<html xmlns:th=\"http://www.thymeleaf.org\" lang=\"es\">\r\n<head th:replace=\"~{layout/base :: head(${pageTitle})}\"></head>\r\n<body class=\"page-body\">\r\n\r\n<nav th:replace=\"~{layout/base :: navbar}\"></nav>\r\n\r\n<main>\r\n    <!-- ===== HERO SECTION ===== -->\r\n    <section class=\"ms-hero\">\r\n        <img class=\"ms-hero-img\"\r\n             src=\"https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=1400&q=80\"\r\n             alt=\"Buceador explorando el fondo marino\"/>\r\n        <div class=\"container-ms w-100 ms-content-wrapper\">\r\n            <div class=\"ms-hero-content ms-animate ms-hero-content-wrap\">\r\n                <div class=\"ms-badge mb-3\">Escuela de Buceo Profesional</div>\r\n                <h1>Explora lo invisible con MouroSub</h1>\r\n                <p class=\"mt-3 mb-4\">\r\n                    Escuela de buceo profesional en Santander. Desde bautismos hasta certificaciones\r\n                    técnicas, sumérgete con seguridad y precisión en el Cantábrico.\r\n                </p>\r\n                <div class=\"d-flex flex-wrap gap-3\">\r\n                    <a th:href=\"@{/servicios}\" class=\"btn btn-ms-primary px-4 py-3 rounded\">\r\n                        Empieza tu aventura\r\n                    </a>\r\n                    <a th:href=\"@{/servicios(tipo=CURSO)}\" class=\"btn ms-hero-btn-secondary px-4 py-3 rounded\">\r\n                        Ver Cursos\r\n                    </a>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <!-- ===== SERVICIOS DESTACADOS ===== -->\r\n    <section class=\"py-5 ms-content-wrapper\">\r\n        <div class=\"d-flex justify-content-between align-items-center mb-4\">\r\n            <h2 class=\"ms-section-title mb-0\">Nuestros Servicios</h2>\r\n            <a th:href=\"@{/servicios}\" class=\"btn btn-ms-outline px-4 py-2 rounded d-none d-md-inline-flex align-items-center gap-2\">\r\n                Ver todos <i class=\"bi bi-arrow-right\"></i>\r\n            </a>\r\n        </div>\r\n\r\n        <!-- Actividades dinámicas desde BD -->\r\n        <div th:if=\"${not #lists.isEmpty(actividadesDestacadas)}\" class=\"ms-idx-servicios-grid\">\r\n            <div th:each=\"act, iterStat : ${actividadesDestacadas}\"\r\n                 th:class=\"${iterStat.index == 0} ? 'ms-idx-card ms-idx-card--main' : 'ms-idx-card'\">\r\n                <!-- Imagen -->\r\n                <div class=\"ms-idx-img-wrap\">\r\n                    <img th:if=\"${act.imagenUrl != null}\"\r\n                         th:src=\"${act.imagenUrl}\" th:alt=\"${act.nombre}\" class=\"ms-idx-img\"/>\r\n                    <!-- Fallback por tipo cuando no hay imagenUrl -->\r\n                    <img th:if=\"${act.imagenUrl == null and act.tipo != null and act.tipo.name() == 'ACTIVIDAD'}\"\r\n                         src=\"https://images.unsplash.com/photo-1579803833898-1dad7f7c0745?w=800&q=75\"\r\n                         th:alt=\"${act.nombre}\" class=\"ms-idx-img\"/>\r\n                    <img th:if=\"${act.imagenUrl == null and act.tipo != null and act.tipo.name() == 'CURSO'}\"\r\n                         src=\"https://images.unsplash.com/photo-1560275619-4cc5fa59d3ae?w=800&q=75\"\r\n                         th:alt=\"${act.nombre}\" class=\"ms-idx-img\"/>\r\n                    <img th:if=\"${act.imagenUrl == null and act.tipo != null and act.tipo.name() == 'INMERSION'}\"\r\n                         src=\"https://images.unsplash.com/photo-1682687220017-cdbe5024a5a7?w=800&q=75\"\r\n                         th:alt=\"${act.nombre}\" class=\"ms-idx-img\"/>\r\n                    <img th:if=\"${act.imagenUrl == null and act.tipo == null}\"\r\n                         src=\"https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=800&q=75\"\r\n                         th:alt=\"${act.nombre}\" class=\"ms-idx-img\"/>\r\n                    <span class=\"ms-badge ms-idx-badge\" th:text=\"${act.tipo}\">CURSO</span>\r\n                </div>\r\n                <!-- Texto -->\r\n                <div class=\"ms-idx-body\">\r\n                    <h3 class=\"ms-idx-title\" th:text=\"${act.nombre}\">Actividad</h3>\r\n                    <p class=\"ms-idx-desc\" th:text=\"${act.descripcion}\">Descripción</p>\r\n                    <a th:href=\"@{/servicios/{id}(id=${act.idActividad})}\"\r\n                       class=\"btn btn-ms-outline px-3 py-2 rounded ms-idx-btn\">Saber más &rarr;</a>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Fallback si no hay actividades -->\r\n        <div th:if=\"${#lists.isEmpty(actividadesDestacadas)}\" class=\"ms-idx-servicios-grid\">\r\n            <div class=\"ms-idx-card ms-idx-card--main\">\r\n                <div class=\"ms-idx-img-wrap\">\r\n                    <img src=\"https://images.unsplash.com/photo-1560275619-4cc5fa59d3ae?w=900&q=80\" alt=\"Cursos de Buceo\" class=\"ms-idx-img\"/>\r\n                    <span class=\"ms-badge ms-idx-badge\">CURSO</span>\r\n                </div>\r\n                <div class=\"ms-idx-body\">\r\n                    <h3 class=\"ms-idx-title\">Cursos de Buceo</h3>\r\n                    <p class=\"ms-idx-desc\">Obtén tu certificación internacional PADI. Desde Open Water hasta niveles profesionales.</p>\r\n                    <a th:href=\"@{/servicios(tipo=CURSO)}\" class=\"btn btn-ms-outline px-3 py-2 rounded ms-idx-btn\">Saber más &rarr;</a>\r\n                </div>\r\n            </div>\r\n            <div class=\"ms-idx-card\">\r\n                <div class=\"ms-idx-img-wrap\">\r\n                    <img src=\"https://images.unsplash.com/photo-1682687220017-cdbe5024a5a7?w=700&q=80\" alt=\"Inmersiones\" class=\"ms-idx-img\"/>\r\n                    <span class=\"ms-badge ms-idx-badge\">INMERSIÓN</span>\r\n                </div>\r\n                <div class=\"ms-idx-body\">\r\n                    <h3 class=\"ms-idx-title\">Inmersiones Diarias</h3>\r\n                    <p class=\"ms-idx-desc\">Salidas programadas a los mejores puntos de la costa cántabra.</p>\r\n                    <a th:href=\"@{/servicios(tipo=INMERSION)}\" class=\"btn btn-ms-outline px-3 py-2 rounded ms-idx-btn\">Saber más &rarr;</a>\r\n                </div>\r\n            </div>\r\n            <div class=\"ms-idx-card\">\r\n                <div class=\"ms-idx-img-wrap\">\r\n                    <img src=\"https://images.unsplash.com/photo-1579803833898-1dad7f7c0745?w=700&q=80\" alt=\"Bautismo de Buceo\" class=\"ms-idx-img\"/>\r\n                    <span class=\"ms-badge ms-idx-badge\">ACTIVIDAD</span>\r\n                </div>\r\n                <div class=\"ms-idx-body\">\r\n                    <h3 class=\"ms-idx-title\">Bautismo de Buceo</h3>\r\n                    <p class=\"ms-idx-desc\">Tu primera inmersión guiada en aguas confinadas. La puerta de entrada al mundo submarino.</p>\r\n                    <a th:href=\"@{/servicios(tipo=ACTIVIDAD)}\" class=\"btn btn-ms-outline px-3 py-2 rounded ms-idx-btn\">Saber más &rarr;</a>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"text-center mt-4 d-md-none\">\r\n            <a th:href=\"@{/servicios}\" class=\"btn btn-ms-outline px-5 py-2 rounded\">Ver todos los servicios</a>\r\n        </div>\r\n    </section>\r\n\r\n    <!-- ===== SOBRE NOSOTROS TEASER ===== -->\r\n    <section class=\"ms-section-alt py-5\">\r\n        <div class=\"ms-content-wrapper\">\r\n            <div class=\"row align-items-center gy-4\">\r\n                <div class=\"col-12 col-md-6\">\r\n                    <h2 class=\"ms-section-title\">\r\n                        Pasión por el Cantábrico\r\n                    </h2>\r\n                    <p class=\"ms-section-text mt-3\">\r\n                        MouroSub nació con la misión de compartir los secretos del mundo submarino bajo una\r\n                        premisa innegociable: la seguridad. Con más de 15 años de experiencia, somos el referente\r\n                        en formación de buceo en el norte.\r\n                    </p>\r\n                    <p class=\"ms-section-text mt-2\">\r\n                        Nuestro equipo de instructores certificados te acompañará en cada aleteo, asegurando que\r\n                        tu única preocupación sea disfrutar de la ingravidez.\r\n                    </p>\r\n                    <a th:href=\"@{/conocenos}\" class=\"d-inline-flex align-items-center gap-2 mt-3 fw-bold ms-section-link\">\r\n                        Conoce a nuestro equipo <i class=\"bi bi-arrow-right\"></i>\r\n                    </a>\r\n                </div>\r\n                <div class=\"col-12 col-md-6\">\r\n                    <div class=\"row g-3\">\r\n                        <div class=\"col-6\">\r\n                            <div class=\"ms-stat-box\">\r\n                                <div class=\"stat-number\">15+</div>\r\n                                <div class=\"stat-label\">Años Experiencia</div>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"col-6\">\r\n                            <div class=\"ms-stat-box\">\r\n                                <div class=\"stat-number\">2k+</div>\r\n                                <div class=\"stat-label\">Alumnos Certificados</div>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"col-6\">\r\n                            <div class=\"ms-stat-box\">\r\n                                <div class=\"stat-number\">50+</div>\r\n                                <div class=\"stat-label\">Zonas de Buceo</div>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"col-6\">\r\n                            <div class=\"ms-stat-box\">\r\n                                <div class=\"stat-number\">PADI</div>\r\n                                <div class=\"stat-label\">Centro Certificado</div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <!-- ===== ÚLTIMAS NOTICIAS ===== -->\r\n    <section class=\"py-5 ms-content-wrapper\">\r\n        <div class=\"d-flex justify-content-between align-items-end mb-4\">\r\n            <div>\r\n                <h2 class=\"ms-news-header-title\">\r\n                    Últimas Noticias\r\n                </h2>\r\n                <p class=\"ms-news-header-text\">Actualidad, eventos y consejos de buceo.</p>\r\n            </div>\r\n            <a th:href=\"@{/noticias}\" class=\"fw-semibold d-none d-md-block ms-news-all-link\">\r\n                Ver todo el blog <i class=\"bi bi-arrow-right\"></i>\r\n            </a>\r\n        </div>\r\n\r\n        <div class=\"row g-4\">\r\n            <div th:each=\"noticia : ${ultimasNoticias}\" class=\"col-12 col-md-4\">\r\n                <div class=\"ms-card ms-news-card h-100\">\r\n                    <div class=\"news-img-wrapper\">\r\n                        <img th:src=\"${noticia.imagenUrl != null ? noticia.imagenUrl : 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=800&q=60'}\"\r\n                             th:alt=\"${noticia.titulo}\"\r\n                             class=\"img-fluid\"/>\r\n                    </div>\r\n                    <div class=\"ms-card-body\">\r\n                        <span class=\"news-cat\" th:text=\"${noticia.categoria}\">CATEGORÍA</span>\r\n                        <p class=\"text-muted mt-1 ms-news-date\" th:text=\"${#temporals.format(noticia.fechaPublicacion, 'dd MMM, yyyy')}\">Fecha</p>\r\n                        <h4 class=\"news-title mt-1\" th:text=\"${noticia.titulo}\">Título</h4>\r\n                        <a th:href=\"@{/noticias/{id}(id=${noticia.idNoticia})}\"\r\n                           class=\"d-inline-flex align-items-center gap-1 mt-2 fw-semibold ms-news-link\">\r\n                            Leer más <i class=\"bi bi-chevron-right\"></i>\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <!-- Fallback -->\r\n            <div th:if=\"${#lists.isEmpty(ultimasNoticias)}\" class=\"col-12\">\r\n                <div class=\"text-center py-5 ms-fallback-text\">\r\n                    <i class=\"bi bi-newspaper ms-empty-icon\"></i>\r\n                    <p class=\"mt-3\">Próximamente publicaremos noticias y artículos.</p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <!-- ===== CTA FINAL ===== -->\r\n    <section class=\"ms-section-dark py-5 text-center\">\r\n        <div class=\"ms-content-wrapper-sm\">\r\n            <h2 class=\"ms-cta-final-title\">¿Listo para sumergirte?</h2>\r\n            <p class=\"mt-3 ms-cta-dark-text\">\r\n                Contáctanos hoy mismo y reserva tu plaza. No pierdas la oportunidad de descubrir un mundo nuevo.\r\n            </p>\r\n            <div class=\"d-flex flex-column flex-md-row gap-3 justify-content-center mt-4\">\r\n                <a th:href=\"@{/contacto}\" class=\"btn ms-btn-white px-5 py-3 rounded fw-semibold\">\r\n                    Solicitar Información\r\n                </a>\r\n                <a href=\"tel:+34942000000\" class=\"btn ms-btn-outline-light px-5 py-3 rounded\">\r\n                    <i class=\"bi bi-telephone me-2\"></i>Llamar ahora\r\n                </a>\r\n            </div>\r\n        </div>\r\n    </section>\r\n</main>\r\n\r\n<footer th:replace=\"~{layout/base :: footer}\"></footer>\r\n<div th:replace=\"~{layout/base :: scripts}\"></div>\r\n\r\n<!-- ===== ESTILOS SOLO PARA LA SECCIÓN DE SERVICIOS DEL INDEX ===== -->\r\n<style>\r\n    /* Grid principal: tarjeta grande a la izquierda, dos pequeñas apiladas a la derecha */\r\n    .ms-idx-servicios-grid {\r\n      display: grid;\r\n      grid-template-columns: 1fr 1fr;\r\n      grid-template-rows: auto;\r\n      gap: 1rem;\r\n    }\r\n\r\n    /* La primera tarjeta ocupa toda la altura del grid (2 filas) */\r\n    .ms-idx-card--main {\r\n      grid-row: span 2;\r\n    }\r\n\r\n    /* Mobile: todo en columna */\r\n    @media (max-width: 767px) {\r\n      .ms-idx-servicios-grid {\r\n        grid-template-columns: 1fr;\r\n      }\r\n      .ms-idx-card--main {\r\n        grid-row: span 1;\r\n      }\r\n    }\r\n\r\n    /* Tarjeta base */\r\n    .ms-idx-card {\r\n      background: var(--ms-surface-white);\r\n      border: 1px solid var(--ms-outline-variant);\r\n      border-radius: 0.5rem;\r\n      overflow: hidden;\r\n      display: flex;\r\n      flex-direction: column;\r\n      transition: box-shadow 0.2s ease, transform 0.2s ease;\r\n    }\r\n    .ms-idx-card:hover {\r\n      box-shadow: 0 6px 20px rgba(0, 66, 117, 0.12);\r\n      transform: translateY(-3px);\r\n    }\r\n\r\n    /* Contenedor de imagen */\r\n    .ms-idx-img-wrap {\r\n      position: relative;\r\n      overflow: hidden;\r\n      height: 200px;\r\n      flex-shrink: 0;\r\n    }\r\n    /* La tarjeta grande tiene imagen más alta */\r\n    .ms-idx-card--main .ms-idx-img-wrap {\r\n      height: 260px;\r\n    }\r\n\r\n    .ms-idx-img {\r\n      width: 100%;\r\n      height: 100%;\r\n      object-fit: cover;\r\n      display: block;\r\n      transition: transform 0.4s ease;\r\n    }\r\n    .ms-idx-card:hover .ms-idx-img {\r\n      transform: scale(1.04);\r\n    }\r\n\r\n    /* Badge encima de la imagen */\r\n    .ms-idx-badge {\r\n      position: absolute;\r\n      top: 0.75rem;\r\n      left: 0.75rem;\r\n    }\r\n\r\n    /* Cuerpo de texto */\r\n    .ms-idx-body {\r\n      padding: 1.25rem 1.25rem 1.5rem;\r\n      display: flex;\r\n      flex-direction: column;\r\n      flex: 1;\r\n    }\r\n\r\n    .ms-idx-title {\r\n      font-size: 1.15rem;\r\n      font-weight: 600;\r\n      color: var(--ms-on-surface);\r\n      margin: 0 0 0.5rem;\r\n      line-height: 1.3;\r\n    }\r\n    .ms-idx-card--main .ms-idx-title {\r\n      font-size: 1.3rem;\r\n    }\r\n\r\n    .ms-idx-desc {\r\n      font-size: 0.875rem;\r\n      color: var(--ms-on-surface-var);\r\n      line-height: 1.65;\r\n      margin: 0;\r\n      flex: 1;\r\n    }\r\n\r\n    .ms-idx-btn {\r\n      margin-top: 1.1rem;\r\n      align-self: flex-start;\r\n      font-size: 0.85rem;\r\n    }\r\n</style>\r\n\r\n</body>\r\n</html>
